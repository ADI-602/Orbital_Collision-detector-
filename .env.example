# =============================================================
# Orbital Risk Advisor — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# =============================================================

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-key-here
# Optional: models to try in order, comma-separated. Default:
# gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite (the next is tried when one is
# overloaded; gemini-2.5-* is retired for new keys)
# GEMINI_MODEL=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite

# Space-Track.org credentials — register at https://www.space-track.org/auth/createAccount
# Free account required; registration can take a day or two, so do this early.
SPACETRACK_USERNAME=your-email@example.com
SPACETRACK_PASSWORD=your-password-here

# Cesium Ion token — get from https://ion.cesium.com/tokens
# Scope: assets:read only (add geocode only if search is used). No private/write scopes.
# Safe to scope narrowly — this token may end up referenced in frontend config.
CESIUM_ION_TOKEN=your-cesium-ion-token-here
