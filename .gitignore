# =============================================================
# Orbital Risk Advisor — .gitignore
# =============================================================

# ------------------------------------------------------------
# Secrets — NEVER commit these
# ------------------------------------------------------------
.env
*.env
.env.*
!.env.example

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
.venv/
venv/
ENV/
env/
pip-wheel-metadata/
*.whl

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov

# mypy / pyright
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ------------------------------------------------------------
# TLE data cache (fetch live — don't commit large data dumps)
# ------------------------------------------------------------
data/
*.tle
*.txt.cache
tle_cache/
celestrak_cache/
# The monitor's last completed pass, kept across restarts (monitoring.py).
backend/.cache/

# ...with ONE deliberate exception. The server's offline tracked set is
# committed on purpose: CelesTrak is a third party we do not control, and a
# blocked IP or venue wifi must not empty the console during a live demo.
# It is a capped subset (see scripts/refresh_tracked_set.py), not a catalogue
# dump, and it holds real unmodified element sets labelled with their epoch.
# Git cannot re-include a file whose parent directory is excluded, so the
# directory is un-ignored first.
!backend/data/
!backend/data/offline_tracked_set.json

# ------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.*
!frontend/.env.example
.npm
.yarn/cache
.yarn/unplugged
.pnp.*

# ------------------------------------------------------------
# OS / editor
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Demo / fallback video (large binary — store externally)
# ------------------------------------------------------------
demo/fallback/*.mp4
demo/fallback/*.mov
demo/fallback/*.mkv

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.log
*.tmp
*.bak
.bob/
temp/

