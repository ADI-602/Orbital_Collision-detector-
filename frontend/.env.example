# =============================================================
# Orbital Risk Advisor — Frontend environment
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is committed.
# =============================================================
#
# NOTE: Vite reads env files from its OWN root (frontend/), not the repo
# root. The repo-root .env is invisible to frontend code, and its keys are
# not VITE_-prefixed, so they would not be exposed even if it were read.
#
# NOTE: import.meta.env.* is statically replaced at BUILD time. Editing
# .env.local requires restarting the dev server — HMR will not pick it up.

# Base URL of the FastAPI backend.
# Start it from the REPO ROOT (backend/api/main.py imports tests.fixtures):
#   backend\.venv\Scripts\uvicorn backend.api.main:app --reload --port 8000
VITE_API_BASE_URL=http://localhost:8000

# Cesium Ion token — copy the CESIUM_ION_TOKEN value from the repo-root .env.
# Scope: assets:read only (no private/write scopes), so it is safe to ship
# to the client. Not referenced in code until Phase 5 step 3 (the globe).
VITE_CESIUM_ION_TOKEN=your-cesium-ion-token-here
